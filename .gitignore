# Python
.venv/
__pycache__/
*.pyc

# Raw downloaded data — reproducible via pipeline/fetch_data.py, not
# worth versioning (the CSV alone is ~20MB and grows every refresh).
data/raw/

# Processed output is a build artifact of the pipeline, regenerated by
# CI on every deploy — see .github/workflows/. Not committed so the repo
# doesn't accumulate a dated JSON file on every run.
data/processed/
site/data/

# OS cruft
.DS_Store
